---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { API_URL } from '../../lib/api';
import { SITE_KIND, SITE_NAME } from '../../lib/site';

const isSchoolSite = SITE_KIND === 'school';
const heroEyebrow = isSchoolSite ? 'Update Terkini' : 'Wawasan & Pembaruan';
const heroTitle = isSchoolSite ? 'Arsip Berita & Kegiatan' : 'Artikel Terbaru HIC-CMS';
const heroDescription = isSchoolSite
  ? 'Informasi terbaru, prestasi, dan kegiatan seru dari lingkungan sekolah.'
  : 'Tutorial, pembaruan produk, dan wawasan seputar Cloudflare Native Headless CMS.';
const searchPlaceholder = isSchoolSite ? 'Cari topik berita...' : 'Cari artikel HIC-CMS...';

// Fetch data from local API for development
const response = await fetch(`${API_URL}/api/posts`).catch(() => null);
const json = response ? await response.json() : { success: false, data: [] };
const posts = json.data || [];
---

<BaseLayout title={`Berita | ${SITE_NAME}`} description={`Kumpulan berita terbaru dari ${SITE_NAME}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <p class="text-sm font-bold uppercase tracking-[.25em] text-[#ff8a1f]">{heroEyebrow}</p>
      <h1 class="mt-3 text-4xl font-extrabold text-[#1e3a8a] sm:text-5xl">{heroTitle}</h1>
      <p class="mt-4 text-xl text-gray-500">{heroDescription}</p>
    </div>

    <div class="mb-10 rounded-[2rem] border border-slate-100 bg-white p-4 shadow-sm">
      <div class="flex justify-end">
        <label class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-500 md:max-w-md">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" aria-hidden="true">
            <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" />
            <circle cx="11" cy="11" r="6" stroke-width="2" />
          </svg>
          <input
            type="search"
            placeholder={searchPlaceholder}
            class="blog-search-input w-full bg-transparent text-base text-slate-700 outline-none placeholder:text-slate-400"
          />
        </label>
      </div>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20 bg-white rounded-2xl shadow-sm border border-gray-100">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Belum Ada Artikel</h3>
        <p class="mt-1 text-sm text-gray-500">Mulai buat artikel pertama Anda di Dashboard Admin.</p>
      </div>
    ) : (
      <div class="blog-grid grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post: any) => (
          <div class="blog-search-item" data-search-text={`${post.title ?? ''} ${post.excerpt ?? ''} ${post.category ?? ''} ${post.author ?? ''}`.toLowerCase()}>
            <PostCard 
            title={post.title} 
            excerpt={post.excerpt} 
            slug={post.slug} 
            category={post.category} 
            author={post.author} 
            publishedAt={post.published_at} 
            image={post.og_image}
            viewCount={post.view_count}
            />
          </div>
        ))}
      </div>
    )}
  </div>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('.blog-search-input')
    const items = [...document.querySelectorAll<HTMLElement>('.blog-search-item')]
    searchInput?.addEventListener('input', () => {
      const keyword = (searchInput.value || '').trim().toLowerCase()
      items.forEach((item) => {
        const haystack = item.dataset.searchText || ''
        item.style.display = !keyword || haystack.includes(keyword) ? '' : 'none'
      })
    })
  </script>
</BaseLayout>
