---
import type { Page } from '@hiccms/page-manager';
import Layout from '../layouts/Layout.astro';
import { resolveMediaUrl } from '../lib/media';
import { API_URL } from '../lib/api';
export async function getStaticPaths() {
  try {
    const res = await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:8787'}/api/pages`);
    const data = await res.json();
    if (data.success) {
      return data.data.map((page: any) => ({ params: { slug: page.slug } }));
    }
  } catch (e) {
    console.error("Failed to fetch pages for getStaticPaths", e);
  }
  return [];
}

const { slug } = Astro.params;
const response = await fetch(`${API_URL}/api/pages/${slug}`);
if (!response.ok) return Astro.redirect('/404');
const result = await response.json();
const page = result.data as Page;
const imageUrl = resolveMediaUrl(page.featuredImage);
---
<Layout title={page.metaTitle || page.title} description={page.metaDescription || page.excerpt} metaKeywords={page.metaKeywords} ogImage={imageUrl}>
  <article class:list={["mx-auto", { "max-w-3xl": page.template !== 'full-width', "max-w-none": page.template === 'full-width' }]}>
    <header class="mb-10 text-center"><h1 class="text-4xl font-extrabold md:text-5xl">{page.title}</h1>{page.excerpt && <p class="mt-4 text-xl text-gray-500">{page.excerpt}</p>}</header>
    {imageUrl && <img src={imageUrl} alt={`Gambar ${page.title}`} class="mb-10 aspect-video w-full rounded-2xl object-cover" />}
    <div class="prose prose-lg max-w-none dark:prose-invert" set:html={page.content}></div>
  </article>
</Layout>
