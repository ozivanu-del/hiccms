---
interface Props {
  phone: string;
  label?: string;
  message?: string;
}

const { phone, label = 'Hubungi via WhatsApp', message = '' } = Astro.props;
const digits = phone.replace(/\D/g, '');
const normalizedPhone = digits.startsWith('620')
  ? `62${digits.slice(3)}`
  : digits.startsWith('0')
    ? `62${digits.slice(1)}`
    : digits.startsWith('8')
      ? `62${digits}`
      : digits;
const validPhone = /^\d{8,15}$/.test(normalizedPhone);
const finalLabel = label.trim() || 'Hubungi via WhatsApp';
const href = validPhone
  ? `https://wa.me/${normalizedPhone}${message.trim() ? `?text=${encodeURIComponent(message.trim())}` : ''}`
  : '';
---

{validPhone && (
  <>
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={finalLabel}
      title={finalLabel}
      class="wa-bubble fixed bottom-5 right-5 z-[60] inline-flex min-h-14 min-w-14 items-center justify-center gap-2 rounded-full bg-[#25D366] px-2 sm:px-4 text-sm font-bold text-slate-950 shadow-xl ring-1 ring-black/10 transition hover:-translate-y-1 hover:bg-[#20bd5a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#128C7E] md:bottom-6 md:right-6"
    >
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white shadow-sm" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-7 w-7 fill-[#25D366]">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.075-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.895 9.83 9.83 0 0 1 2.9 6.988c-.002 5.45-4.437 9.884-9.892 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z" />
        </svg>
      </span>
      <span class="hidden sm:inline">{finalLabel}</span>
    </a>

    <style>
      .wa-bubble {
        animation: wa-bubble-float 3.2s ease-in-out infinite;
      }

      @keyframes wa-bubble-float {
        0%, 100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .wa-bubble {
          animation: none;
        }
      }
    </style>
  </>
)}
