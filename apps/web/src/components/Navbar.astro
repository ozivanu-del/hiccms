---
import { SITE_KIND, SITE_NAME } from '../lib/site';

const isSchoolSite = SITE_KIND === 'school';
const contactLabel = isSchoolSite
  ? 'Kontak sekolah tersedia di halaman profil'
  : 'Cloudflare Native Headless CMS yang cepat, modern, dan mudah dikembangkan';
const blogLabel = isSchoolSite ? 'Berita' : 'Blog';
const aboutLabel = isSchoolSite ? 'Profil' : 'Tentang';
const ctaLabel = isSchoolSite ? 'Profil Sekolah' : 'Tentang HIC-CMS';
---

<div class="bg-[#1d4ed8] text-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2 text-xs sm:px-6 lg:px-8 sm:text-sm">
    <div class="flex items-center gap-2 font-medium">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-white/15">
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5 6.5 6.5l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V21c0 .6-.4 1-1 1C10.6 22 2 13.4 2 2c0-.6.4-1 1-1h4.6c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2.3 2Z"/></svg>
      </span>
      <span>{contactLabel}</span>
    </div>
    <div class="flex items-center gap-2">
      <a href="#" aria-label="Instagram" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25">
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 1.8A3.7 3.7 0 0 0 3.8 7.5v9a3.7 3.7 0 0 0 3.7 3.7h9a3.7 3.7 0 0 0 3.7-3.7v-9a3.7 3.7 0 0 0-3.7-3.7h-9Zm9.75 1.35a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8Z" /></svg>
      </a>
      <a href="#" aria-label="Facebook" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25">
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V9c0-.9.3-1.5 1.6-1.5h1.7V4.7c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H8V14h2.4v8h3.1Z" /></svg>
      </a>
    </div>
  </div>
</div>

<nav class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 shadow-sm backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-extrabold text-[#1e3a8a]">{SITE_NAME}</a>
      </div>
      <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
        <a href="/" class="inline-flex items-center px-1 pt-1 font-semibold text-[#1e3a8a] transition-colors hover:text-[#f59e0b]">Beranda</a>
        <a href="/blog" class="inline-flex items-center px-1 pt-1 font-semibold text-[#1e3a8a] transition-colors hover:text-[#f59e0b]">{blogLabel}</a>
        <a href="/about" class="inline-flex items-center px-1 pt-1 font-semibold text-[#1e3a8a] transition-colors hover:text-[#f59e0b]">{aboutLabel}</a>
      </div>
      <div>
        <a href="/about" class="rounded-full bg-[#312e81] px-4 py-2 font-semibold text-white shadow-sm transition hover:brightness-110">{ctaLabel}</a>
      </div>
    </div>
  </div>
</nav>
