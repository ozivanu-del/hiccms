---
import { resolveMediaUrl } from '../lib/media';
import ViewCount from './ViewCount.astro';

interface Props {
  post: Record<string, any>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const imageUrl = resolveMediaUrl(post.og_image);
---

<article class:list={[
  'not-prose overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-700 dark:bg-slate-800',
  { 'my-10 flex flex-col sm:flex-row': compact },
]}>
  <a href={`/blog/${post.slug}`} class:list={['block overflow-hidden bg-slate-100 dark:bg-slate-700', compact ? 'sm:w-48 sm:flex-none' : 'aspect-video']} aria-label={`Baca ${post.title}`}>
    {imageUrl ? (
      <img src={imageUrl} alt={`Thumbnail ${post.title}`} loading="lazy" decoding="async" width="640" height="360" class="h-full w-full object-cover" />
    ) : (
      <div class="flex h-full min-h-28 items-center justify-center bg-gradient-to-br from-primary/15 to-secondary/15 text-sm font-semibold text-primary">HIC-CMS</div>
    )}
  </a>
  <div class:list={['flex min-w-0 flex-1 flex-col', compact ? 'p-5' : 'p-5']}>
    <p class="!m-0 text-xs font-bold uppercase tracking-widest text-primary">Artikel terkait</p>
    <h3 class="!mb-0 !mt-2 text-lg font-bold leading-snug text-slate-900 dark:text-white">
      <a href={`/blog/${post.slug}`} class="no-underline hover:text-primary">{post.title}</a>
    </h3>
    {post.excerpt && <p class="!mb-0 !mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{post.excerpt}</p>}
    <ViewCount count={post.view_count} class="mt-3 text-xs text-slate-500 dark:text-slate-400" />
  </div>
</article>
