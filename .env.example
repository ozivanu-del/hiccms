# Public browser/build configuration only. Never commit real credentials here.
VITE_API_URL=http://localhost:8787
PUBLIC_API_URL=http://localhost:8787
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=HIC-CMS

# Worker secrets: use .dev.vars locally and `wrangler secret put <NAME>` in production.
JWT_SECRET=
RESEND_API_KEY=

# Non-secret Worker configuration.
ENVIRONMENT=development
ADMIN_URL=http://localhost:5173
SITE_NAME=HIC-CMS
RESET_EMAIL_FROM=HIC-CMS <noreply@example.com>
